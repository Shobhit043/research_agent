GROQ_API_KEY=your-groq-api-key

# --- Optional ---
# AGENT_MODEL=openai/gpt-oss-20b
# USE_EMBEDDINGS=true                 # hybrid BM25 + embedding retrieval (false = BM25 only)
# ENABLED_TOOLS=web_search,search_documents,read_document,fetch_url,wikipedia_search,arxiv_search,get_time,place_info
#                                     # unset = all tools; each bound tool costs ~150 prompt tokens

# Identify HTTP tools to Wikipedia/arXiv; include a contact URL or email to avoid throttling.
# HTTP_USER_AGENT=ResearchAssistant/0.4 (https://your-site.example; you@example.com)

# Database: unset = SQLite in DATA_DIR. docker-compose sets this to its Postgres service.
# DATABASE_URL=postgresql://user:password@localhost:5432/assistant
# POSTGRES_PASSWORD=change-me          # used by docker-compose's db service

# Security: required before exposing the server beyond localhost. Comma-separated.
# APP_API_KEYS=long-random-key-1,long-random-key-2
# CORS_ORIGINS=https://your-frontend.example.com

# Limits
# CHAT_PER_MINUTE=10
# SESSION_TOKEN_BUDGET=300000
# MAX_UPLOAD_MB=20
# SESSION_TTL_DAYS=7

# Storage and logging
# DATA_DIR=data
# LOG_FORMAT=json                     # text (default) or json

# Tracing: LangChain sends traces to LangSmith automatically when these are set.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=research-assistant
